# --- API keys ---
ALPHA_VANTAGE_API_KEY=

# --- MongoDB Atlas (free M0 cluster) ---
# Atlas UI -> Connect -> Drivers -> copy the connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=price_tracker
# Old price points auto-expire (TTL index) to stay under the free tier's 512 MB cap
PRICE_TTL_DAYS=30

# --- Notifications ---
NOTIFY_CHANNEL=console
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Polling ---
POLL_INTERVAL_SECONDS=60
